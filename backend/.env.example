NODE_ENV=development
PORT=5000

MONGO_URI=
MONGO_URI_DIRECT=
JWT_SECRET=
REFRESH_SECRET=
JWT_EXPIRE=15m
REFRESH_EXPIRE=30d
COOKIE_SECRET=
SESSION_SECRET=
COOKIE_DOMAIN=
COOKIE_SAME_SITE=Lax
ENFORCE_HTTPS=true

FRONTEND_URL=https://purefumeshyderabad.in
CLIENT_URL=https://purefumeshyderabad.in
BACKEND_URL=https://purefumeshyderabad.in
CORS_ORIGIN=https://purefumeshyderabad.in,https://www.purefumeshyderabad.in,https://tanstack-start-app.hydpurefumes.workers.dev

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://purefumeshyderabad.in/auth/google/callback

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
SMTP_SECURE=false
PAYMENT_MODE=live
BYPASS_PAYMENT=false

REDIS_URL=

SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.05

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Use either CLOUDINARY_URL or the three separate Cloudinary credentials.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PRODUCT_FOLDER=purefumes-hyderabad/products
MONGO_AUTO_INDEX=true

ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Optional legacy migration keys. Prefer ADMIN_EMAIL + ADMIN_PASSWORD_HASH instead.
ADMIN_USER=
ADMIN_PASS=
